    message: String? = null,
    modifier: Modifier = Modifier,
    kind: ShieldraBannerKind = ShieldraBannerKind.Info,
    icon: ImageVector? = null,
    actionLabel: String? = null,
    onAction: (() -> Unit)? = null,
    onDismiss: (() -> Unit)? = null,
